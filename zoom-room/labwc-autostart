# WAVE zoom-room — install to ~/.config/labwc/autostart on the kiosk user.
#
# Install: mkdir -p ~/.config/labwc && cp labwc-autostart ~/.config/labwc/autostart
#
# This is the same file the official Raspberry Pi kiosk tutorial edits
# (https://www.raspberrypi.com/tutorials/how-to-use-a-raspberry-pi-in-kiosk-mode/
# "Set up kiosk mode": `.config/labwc/autostart`). The tutorial launches
# chromium directly from here; this profile launches it via the systemd
# --user unit wave-zoom-room-kiosk.service instead, so the kiosk gets
# Restart=on-failure supervision, `journalctl --user -u wave-zoom-room-kiosk`
# logging, and ROOM_URL from the kiosk user's mode-0600
# ~/.config/wave/zoom-room.env instead of a URL hardcoded in this
# world-readable file. That unit still wraps
# chromium in /usr/bin/lwrespawn — the labwc respawn helper Raspberry Pi's
# own rpi-image-gen kiosk layer uses in exactly this autostart position
# (contrib/src/cm5-programming-jig/layer/cm5-jig-desktop.yaml, master) — so
# a crashed browser is relaunched at both the lwrespawn and systemd layers.
#
# systemd --user services do not automatically inherit the Wayland session's
# environment variables, so import them explicitly before starting the unit.
# Whether Raspberry Pi OS's own labwc session script already does this is
# UNPROVEN on this device (see docs/zoom-room.md); importing twice is
# harmless.
systemctl --user import-environment WAYLAND_DISPLAY DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE
systemctl --user start wave-zoom-room-kiosk.service &

# No `swayidle -w timeout 600 'wlopm --off \*' resume 'wlopm --on \*' &`
# line is added on purpose. On Raspberry Pi OS Bookworm/Trixie, raspi-config's
# "Screen Blanking" toggle (do_blanking, RPi-Distro/raspi-config `bookworm`
# branch, LABWCAST_FILE="$HOMEDIR/.config/labwc/autostart") works by
# appending or `sed -i '/swayidle/d'`-removing exactly that line from THIS
# file — its absence is the "blanking disabled" state. Equivalent one-liner:
#   sudo raspi-config nonint do_blanking 1

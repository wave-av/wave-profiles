# WAVE zoom-room — ~/.config/wave/zoom-room.env (on the kiosk user, NOT /etc)
#
# Install, as the kiosk user (no sudo — the reader is that user's own
# systemd --user manager, so the file must be owned by and readable to the
# kiosk user; a root-owned 0600 file under /etc would be unreadable to it):
#          install -d -m 0700 ~/.config/wave
#          install -m 0600 zoom-room.env.example ~/.config/wave/zoom-room.env
#          nano ~/.config/wave/zoom-room.env   # fill in the real ROOM_URL
#
# Never commit the real ~/.config/wave/zoom-room.env — it lives only on the
# device. This .example file (no real values) is the only copy tracked in
# git; the repo's public-repo-guard + gitleaks gates scan the tree for
# accidental commits of a populated env file.
#
# ROOM_URL is the page this Pi's kiosk Chromium loads at boot: a page
# hosting the Zoom Meeting SDK for Web (Component View, @zoom/meetingsdk)
# that joins the target meeting as a participant. It is NOT a raw
# https://zoom.us/j/... meeting link and NOT a Zoom Rooms controller URL —
# the Pi 5 cannot run Zoom Rooms (Windows x86-64 / macOS / certified
# appliances only). See docs/zoom-room.md.
ROOM_URL=https://example.invalid/zoom-room/CHANGEME
